  "cards": [
    {
      "dot": "cyan",
      "title": "Job Lifecycle",
      "items": [
        "pending → processing (claimed via FOR UPDATE SKIP LOCKED)",
        "processing → completed (HTTP 2xx + Redis TTL seal to 24h)",
        "processing → pending (retry: exponential backoff + jitter)",
        "processing → failed (max attempts exhausted)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Concurrency Model",
      "items": [
        "Semaphore channel limits goroutines (default 10 concurrent)",
        "sync.WaitGroup tracks in-flight jobs for graceful shutdown",
        "Multiple workers safe: SKIP LOCKED (PG) + SET NX (Redis)"
      ]
    },
    {
      "dot": "rose",
      "title": "Tech Stack",
      "items": [
        "Go 1.25, pgx/v5 connection pool, go-redis/v9",
        "PostgreSQL 16 + Redis 7 (docker-compose)",
        "slog structured logging, UUID idempotency keys"
      ]
    }
  ]
